# MT-Linker Configuration Example
# ================================
# Copy this file to mtklink-config.yml and configure your settings.

# Authentication type: "wp" | "mtk" | "adt" | "none"
type: "none"

# For type="none": Custom authentication endpoint and key
auth: "https://your-auth-api.example.com/verify"
key: "your-secret-key-here"

# SQLite credentials (auto-generated by system, do not modify)
sqlite-user: ""
sqlite-key: ""
